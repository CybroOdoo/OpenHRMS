<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_loan_early_settlement_form" model="ir.ui.view">
        <field name="name">hr.loan.early.settlement.form</field>
        <field name="model">hr.loan.early.settlement</field>
        <field name="arch" type="xml">
            <form string="Early Settlement">
                <group>
                    <field name="loan_id" readonly="1" invisible="1"/>
                    <field name="amount" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                    <field name="settlement_type" widget="radio"/>
                </group>
                <footer>
                    <button string="Confirm Settlement" name="action_settle" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hr_loan_early_settlement" model="ir.actions.act_window">
        <field name="name">Early Settlement</field>
        <field name="res_model">hr.loan.early.settlement</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_hr_loan_early_settlement_form"/>
        <field name="target">new</field>
    </record>
</odoo>
