<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Added checkbox for approval from account manager -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.inherits.ohrms.loan.accounting</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id"
               ref="ohrms_loan.res_config_settings_view_form_loan"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='hr_loan_setting_container']" position="inside">
                <setting string="Approval from Accounting Department" help="Loan Approval from account manager">
                    <field name="loan_approve"/>
                    <div class="content-group mt16" invisible="not loan_approve">
                        <label for="loan_approval_threshold" string="Approval Threshold"/>
                        <field name="loan_approval_threshold" class="oe_inline"/>
                        <div class="text-muted">
                            Loans strictly below this amount will bypass Account Manager approval.
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
