<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Added some additional buttons on the loan request form view -->
    <record id="hr_loan_view_form" model="ir.ui.view">
        <field name="name">hr.loan.view.form.inherit.ohrms.loan.accounting</field>
        <field name="model">hr.loan</field>
        <field name="inherit_id" ref="ohrms_loan.hr_loan_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="replace">
                <header>
                    <button name="action_compute_installment" type="object"
                            string="Compute Installment"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_submit" type="object"
                            string="Submit" invisible="state !='draft'"
                            class="oe_highlight"/>
                    <button name="action_cancel" type="object"
                            string="Cancel" invisible="state !='draft'"/>
                    <button name="action_approve" type="object"
                            string="Approve"
                            invisible="state != 'waiting_approval_1'"
                            class="oe_highlight"
                            groups="hr.group_hr_manager"/>
                    <button name="action_double_approve" type="object"
                            string="Finance Approve"
                            invisible="state != 'waiting_approval_2'"
                            class="oe_highlight"
                            groups="account.group_account_manager"/>
                    <button name="action_refuse" type="object"
                            string="Refuse"
                            invisible="state not in ('waiting_approval_1','waiting_approval_2')"
                            class="oe_highlight"
                            groups="hr.group_hr_manager"/>
                    <button name="action_early_settlement" type="object" string="Early Settlement"
                            invisible="state != 'approve' or balance_amount &lt;= 0"
                            class="oe_highlight"
                            confirm="Are you sure you want to settle the remaining loan amount?"
                            groups="hr.group_hr_manager"/>
                    <button name="action_deferment" type="object" string="Defer Installment"
                            invisible="state != 'approve' or balance_amount &lt;= 0"
                            class="oe_highlight"
                            groups="hr.group_hr_manager"/>
                    <button name="action_topup" type="object" string="Top-Up Loan"
                            invisible="state != 'approve' or balance_amount &lt;= 0"
                            class="oe_highlight"
                            groups="hr.group_hr_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,waiting_approval_1,approve"/>
                </header>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Accounting" groups="hr.group_hr_manager" invisible="state == 'draft'">
                    <group>
                        <group>
                            <field name="journal_id" readonly="state in ('approve', 'refuse')"/>
                            <field name="loan_receivable_account_id" readonly="state in ('approve', 'refuse')"/>
                            <field name="interest_income_account_id" readonly="state in ('approve', 'refuse')"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_journal_entries" type="object" class="oe_stat_button" icon="fa-book" invisible="move_count == 0">
                    <field name="move_count" widget="statinfo" string="Journal Entries"/>
                </button>
            </xpath>
        </field>
    </record>
 </odoo>
