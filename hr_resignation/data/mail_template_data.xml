<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="mail_template_resignation_exit_interview" model="mail.template">
            <field name="name">Resignation: Exit Interview Invite</field>
            <field name="model_id" ref="survey.model_survey_user_input"/>
            <field name="subject">Exit Interview: {{ object.partner_id.name or 'Employee' }}</field>
            <field name="email_from">{{ user.email_formatted }}</field>
            <field name="email_to" eval="False"/>
            <field name="use_default_to" eval="True"/>
            <field name="description">Sent to employee when inviting them to an exit interview survey</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px; font-size: 13px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.partner_id.name or 'employee'">employee</t>,
                        <br/>
                        <br/>
                        We are sorry to see you go! As part of our offboarding process, we would highly appreciate it if
                        you could take a few minutes to complete our Exit Interview.
                        <br/>
                        <br/>
                        Your honest feedback is incredibly valuable to us and will help us improve our workplace for
                        everyone.
                        <div style="margin: 16px 0px 16px 0px;">
                            <a t-att-href="(object.get_start_url())"
                               t-attf-style="background-color: {{user.company_id.email_secondary_color or '#875A7B'}}; padding: 8px 16px 8px 16px; text-decoration: none; color: {{user.company_id.email_primary_color or '#FFFFFF'}}; border-radius: 5px; font-size:13px;">
                                Start Exit Interview
                            </a>
                        </div>
                        <t t-if="object.deadline">
                            Please complete the survey before <t t-out="format_date(object.deadline) or ''"></t>.
                            <br/>
                            <br/>
                        </t>
                        Thank you for your contributions, and we wish you all the best in your future endeavors!
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
