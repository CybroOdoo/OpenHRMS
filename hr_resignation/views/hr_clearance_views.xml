<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- hr.clearance.type views -->
    <record id="view_hr_clearance_type_tree" model="ir.ui.view">
        <field name="name">hr.clearance.type.tree</field>
        <field name="model">hr.clearance.type</field>
        <field name="arch" type="xml">
            <list string="Clearance Types" editable="bottom">
                <field name="name"/>
                <field name="department_id"/>
                <field name="default_responsible_id"/>
            </list>
        </field>
    </record>

    <record id="action_hr_clearance_type" model="ir.actions.act_window">
        <field name="name">Clearance Types</field>
        <field name="res_model">hr.clearance.type</field>
        <field name="view_mode">list</field>
    </record>

    <!-- hr.clearance.template views -->
    <record id="view_hr_clearance_template_tree" model="ir.ui.view">
        <field name="name">hr.clearance.template.tree</field>
        <field name="model">hr.clearance.template</field>
        <field name="arch" type="xml">
            <list string="Clearance Templates">
                <field name="name"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_hr_clearance_template_form" model="ir.ui.view">
        <field name="name">hr.clearance.template.form</field>
        <field name="model">hr.clearance.template</field>
        <field name="arch" type="xml">
            <form string="Clearance Template">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Template Name"/>
                        </h1>
                    </div>
                    <group>
                        <field name="company_id"/>
                    </group>
                    <notebook>
                        <page string="Clearance Types">
                            <field name="clearance_type_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="department_id"/>
                                    <field name="default_responsible_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_clearance_template" model="ir.actions.act_window">
        <field name="name">Clearance Templates</field>
        <field name="res_model">hr.clearance.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_resignation_config"
              name="Configuration"
              parent="hr_resignation_menu_root"
              sequence="100"/>
              
    <menuitem id="menu_hr_clearance_type"
              name="Clearance Types"
              parent="menu_hr_resignation_config"
              action="action_hr_clearance_type"
              sequence="10"/>

    <menuitem id="menu_hr_clearance_template"
              name="Clearance Templates"
              parent="menu_hr_resignation_config"
              action="action_hr_clearance_template"
              sequence="20"/>

</odoo>
