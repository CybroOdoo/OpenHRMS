<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit the res.company form view and add company_registry, employer_id, and wps_agent_id -->
    <record id="view_company_form" model="ir.ui.view">
        <field name="name">res.company.view.form.inherit.uae.wps.report</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='identifiers']" position="after">
                <field name="company_registry"/>
                <field name="employer_id"/>
                <field name="wps_agent_id"/>
            </xpath>
        </field>
    </record>
</odoo>
