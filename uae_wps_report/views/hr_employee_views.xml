<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit the hr.employee form view and add WPS fields to it -->
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.uae.wps.report</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='hr_settings']" position="after">
                <page name="wps_info" string="WPS (UAE)" groups="hr.group_hr_user">
                    <group string="UAE Wages Protection System (WPS)">
                        <group>
                            <field name="labour_card_number"/>
                            <field name="salary_card_number"/>
                        </group>
                        <group>
                            <field name="agent_id"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
