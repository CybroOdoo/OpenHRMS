<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Privilege for Appraisal -->
    <record model="res.groups.privilege" id="res_groups_privilege_appraisal">
        <field name="name">Appraisal</field>
        <field name="sequence">15</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- Employee user group -->
    <record id="oh_appraisal_group_employee" model="res.groups">
        <field name="name">Employee</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_appraisal"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Manager user group -->
    <record id="oh_appraisal_group_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_appraisal"/>
        <field name="implied_ids" eval="[(4, ref('oh_appraisal_group_employee'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
