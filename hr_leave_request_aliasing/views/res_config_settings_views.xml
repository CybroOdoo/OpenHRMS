<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit res_config_settings form view to include alias_prefix and alias_domain fields -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.leave.request.aliasing</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr']" position="inside">
                <block title="Time Off" id="hr_leave_email_alias">
                    <setting string="Leave Email Alias"
                             help="Set up a generic email alias to easily create incoming leave requests. To submit a request, send an email with the subject line starting with the prefix, and include 'Date From: DD/MM/YYYY' and 'Date To: DD/MM/YYYY' in the email body.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="alias_prefix"
                                       string="Prefix"
                                       class="col-md-3"/>
                                <field name="alias_prefix"/>
                            </div>
                            <div class="row mt16">
                                <label for="alias_domain"
                                       string="Domain"
                                       class="col-md-3"/>
                                <field name="alias_domain"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
