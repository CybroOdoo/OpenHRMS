<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="hr_employee_document_comp_rule" model="ir.rule">
            <field name="name">Employee Document multi company rule</field>
            <field name="model_id" ref="model_hr_employee_document"/>
            <field name="domain_force">
                [('company_id', 'in', company_ids + [False])]
            </field>
        </record>

        <record id="hr_employee_document_employee_rule" model="ir.rule">
            <field name="name">Employee Document: own documents only</field>
            <field name="model_id" ref="model_hr_employee_document"/>
            <field name="domain_force">
                [('employee_id.user_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="hr_employee_document_officer_rule" model="ir.rule">
            <field name="name">Employee Document: officer manage all</field>
            <field name="model_id" ref="model_hr_employee_document"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        </record>
    </data>
</odoo>
