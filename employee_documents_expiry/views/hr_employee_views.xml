<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--Inherit Documents super button for hr_employee button-->
    <record id="hr_employee_view_form_inherit_employee_documents_expiry" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit.employee.documents.expiry</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div class="oe_button_box" position="inside">
                <button class="oe_stat_button" name="action_document_view"
                        type="object" icon="fa-check-square-o">
                    <field string="Checklist Documents" name="document_expiry_count"
                           widget="statinfo"/>
                </button>
            </div>
        </field>
    </record>
</odoo>
