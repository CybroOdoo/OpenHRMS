<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="document_renew_wizard_view_form" model="ir.ui.view">
        <field name="name">document.renew.wizard.view.form</field>
        <field name="model">document.renew.wizard</field>
        <field name="arch" type="xml">
            <form string="Renew Document">
                <group>
                    <group>
                        <field name="issue_date"/>
                        <field name="expiry_date"/>
                    </group>
                    <group>
                        <field name="doc_attachment_ids" widget="many2many_binary" class="oe_inline"/>
                    </group>
                </group>
                <group>
                    <field name="renewal_reason" placeholder="e.g. Renewed after expiry, Lost original document, etc."/>
                </group>
                <footer>
                    <button string="Confirm" name="action_confirm_renew" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_document_renew_wizard" model="ir.actions.act_window">
        <field name="name">Renew Document</field>
        <field name="res_model">document.renew.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
