<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    Form view of document_type model.-->
    <record id="document_type_view_form" model="ir.ui.view">
        <field name="name">document.type.view.form</field>
        <field name="model">document.type</field>
        <field name="arch" type="xml">
            <form string="Document Name">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="notification_type"/>
                            <field name="before_days" string="Days Before" help="Number of days before the expiry date to send the advance notification." invisible="notification_type != 'multi'"/>
                            <field name="before_days" string="Start Days Before" help="Number of days before the expiry date to start sending daily notifications." invisible="notification_type != 'everyday'"/>
                            <field name="before_days" string="Days After" help="How many days after the expiry date to continue notifying." invisible="notification_type != 'everyday_after'"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <!--    Tree view of document_type model.-->
    <record id='document_type_view_tree' model='ir.ui.view'>
        <field name="name">document.type.view.tree</field>
        <field name="model">document.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="notification_type"/>
                <field name="before_days" string="Days" invisible="notification_type == 'single' or notification_type == False"/>
            </list>
        </field>
    </record>
    <!--   Action of document type model.-->
    <record id="document_type_action" model="ir.actions.act_window">
        <field name="name">Employee Document Types</field>
        <field name="res_model">document.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <!--   Menu item for document_type model.-->
    <menuitem id="document_type_menu"
              name="Employee Document Types"
              parent="hr.menu_human_resources_configuration"
              sequence="6"
              action="document_type_action"/>
</odoo>
