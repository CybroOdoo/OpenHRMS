<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!--    Request visibility ir rule-->
    <record id="request_visibility" model="ir.rule">
        <field name="name">Request Visibility</field>
        <field ref="model_service_request" name="model_id"/>
        <field name="domain_force">['|',
            ('employee_id.work_contact_id.id','=',user.partner_id.id),
            ('employee_id.work_contact_id','=',False)]
        </field>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]"/>
    </record>
    <!--    Administrator visibility ir rule-->
    <record id="admin_visibility" model="ir.rule">
        <field name="name">Administrator Visibility</field>
        <field ref="model_service_request" name="model_id"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]"/>
    </record>
    <!--    Execute visibility ir rule-->
    <record id="execute_visibility" model="ir.rule">
        <field name="name">Execute Visibility</field>
        <field ref="model_service_execute" name="model_id"/>
        <field name="domain_force">['|',
            ('executor_id.user_id','=',user.id),
            ('executor_id','=',False)]
        </field>
        <field name="groups" eval="[(4, ref('ohrms_service_request.service_group_executor'))]"/>
    </record>

    <!--    Execute Administrator visibility ir rule-->
    <record id="execute_admin_visibility" model="ir.rule">
        <field name="name">Execute Administrator Visibility</field>
        <field ref="model_service_execute" name="model_id"/>
        <field name="domain_force">[]</field>
        <field name="groups" eval="[(4, ref('hr_attendance.group_hr_attendance_manager'))]"/>
    </record>
</odoo>
