<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="hr_reward_warning.AnnouncementSystray" owl="1">
        <Dropdown position="'bottom-end'" state="dropdown" bottomSheet="false" beforeOpen.bind="fetchAnnouncements">
            <button>
                <i class="fa fa-lg fa-bullhorn" role="img" aria-label="Announcements"></i>
                <span t-if="state.announcements.length > 0" class="badge rounded-pill text-bg-success position-absolute" style="top: 12px; right: -2px;">
                    <t t-esc="state.announcements.length"/>
                </span>
            </button>
            <t t-set-slot="content">
                <div class="d-flex flex-column list-group list-group-flush shadow" style="min-width: 320px; max-height: 400px; overflow-y: auto;">
                    <div class="list-group-item text-center fw-bold bg-light py-2">
                        Announcements
                    </div>
                    <t t-if="state.announcements.length === 0">
                        <div class="list-group-item text-muted text-center p-4">
                            <i class="fa fa-check-circle-o fa-2x mb-2 text-success"></i><br/>
                            No active announcements
                        </div>
                    </t>
                    <t t-else="">
                        <t t-foreach="state.announcements" t-as="announcement" t-key="announcement.id">
                            <a class="list-group-item list-group-item-action d-flex flex-column py-2" t-on-click="() => this.openAnnouncement(announcement.id)" style="cursor: pointer;">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="text-truncate" style="max-width: 200px;"><t t-esc="announcement.title"/></strong>
                                    <span class="badge text-bg-info"><t t-esc="announcement.date"/></span>
                                </div>
                                <small class="text-muted"><t t-esc="announcement.category"/></small>
                            </a>
                        </t>
                    </t>
                </div>
            </t>
        </Dropdown>
    </t>
</templates>
