<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Record Rule: HR Manager can see all announcements -->
        <record id="hr_announcement_manager_rule" model="ir.rule">
            <field name="name">All Announcements for HR Manager</field>
            <field name="model_id" ref="model_hr_announcement"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('hr.group_hr_manager')), (4, ref('hr.group_hr_user'))]"/>
        </record>

        <!-- Record Rule: Employee can only see relevant announcements -->
        <record id="hr_announcement_employee_rule" model="ir.rule">
            <field name="name">Relevant Announcements for Employee</field>
            <field name="model_id" ref="model_hr_announcement"/>
            <field name="domain_force">[
                '|', '|', '|',
                ('is_announcement', '=', True),
                ('employee_ids.user_id', '=', user.id),
                ('department_ids.member_ids.user_id', '=', user.id),
                ('position_ids.employee_ids.user_id', '=', user.id)
            ]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
