<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_salary_advance_payment_wizard" model="ir.ui.view">
        <field name="name">salary.advance.payment.wizard.form</field>
        <field name="model">salary.advance.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Register Payment">
                <group>
                    <group>
                        <field name="advance_id" invisible="1"/>
                        <field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="payment_date"/>
                        <field name="payment_reference"/>
                        <field name="payment_memo"/>
                    </group>
                </group>
                <footer>
                    <button string="Register Payment" name="action_register_payment" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="z"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_salary_advance_payment_wizard" model="ir.actions.act_window">
        <field name="name">Register Payment</field>
        <field name="res_model">salary.advance.payment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_advance_id': active_id}</field>
    </record>
</odoo>
