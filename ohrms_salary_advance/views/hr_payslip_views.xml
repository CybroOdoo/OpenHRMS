<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payslip_form_inherit_advance" model="ir.ui.view">
        <field name="name">hr.payslip.form.inherit.advance</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll_community.hr_payslip_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='input_line_ids']/list/field[@name='code']" position="after">
                <field name="advance_id" column_invisible="True"/>
            </xpath>
            <xpath expr="//field[@name='input_line_ids']/form//field[@name='code']" position="after">
                <field name="advance_id" invisible="True"/>
            </xpath>
        </field>
    </record>
</odoo>
