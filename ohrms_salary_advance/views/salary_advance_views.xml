<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form view of salary advance. -->
    <record id="salary_advance_view_form" model="ir.ui.view">
        <field name="name">salary.advance.view.form</field>
        <field name="model">salary.advance</field>
        <field name="arch" type="xml">
            <form string="Salary Advance">
                <header>
                    <button name="action_submit" string="Submit"
                            invisible="state != 'draft'"
                            type="object" class="oe_highlight"/>
                    <button name="action_approve" string="Approve"
                            invisible="state != 'submitted'"
                            type="object" class="oe_highlight"
                            groups="hr.group_hr_manager"/>
                    <button name="%(action_salary_advance_payment_wizard)d" string="Register Payment"
                            type="action"
                            invisible="state != 'approved'"
                            class="oe_highlight"
                            groups="hr.group_hr_user,account.group_account_user"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'submitted')"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state != 'approved'"
                            groups="hr.group_hr_user"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,submitted,approved"/>
                </header>

                <sheet>
                    <widget name="web_ribbon" title="Closed" bg_color="text-bg-success" invisible="state != 'closed'"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_employee" type="object"
                                class="oe_stat_button" icon="fa-user"
                                invisible="not employee_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Employee</span>
                            </div>
                        </button>
                        <button name="action_view_payments" type="object"
                                class="oe_stat_button" icon="fa-money"
                                invisible="payment_count == 0">
                            <field name="payment_count" widget="statinfo" string="Payments"/>
                        </button>
                        <button name="action_view_journal_entries" type="object"
                                class="oe_stat_button" icon="fa-bars"
                                invisible="move_count == 0">
                            <field name="move_count" widget="statinfo" string="Journal Entries"/>
                        </button>
                        <button name="action_view_payslips" type="object"
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="payslip_count == 0">
                            <field name="payslip_count" widget="statinfo" string="Payslips"/>
                        </button>
                    </div>
                    
                    <div class="oe_title oe_left">
                        <h2>
                            <field name="name" class="oe_inline" readonly="1"/>
                        </h2>
                    </div>
                    
                    <group>
                        <group string="Employee Information">
                            <field name="is_hr_manager" invisible="1"/>
                            <field name="employee_id" readonly="state != 'draft' or not is_hr_manager"/>
                            <field name="department_id" readonly="1" force_save="1"/>
                            <field name="employee_contract_id" readonly="1" force_save="1"/>
                            <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="reason" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="payslip_ids" invisible="1"/>
                            <field name="payment_ids" invisible="1"/>
                            <field name="move_ids" invisible="1"/>
                        </group>
                        <group string="Advance Information">
                            <field name="advance" readonly="state != 'draft'" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            
                            <separator string="Eligibility Information" invisible="not employee_id" groups="hr.group_hr_user"/>
                            <field name="monthly_wage" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not employee_id" groups="hr.group_hr_user"/>
                            <field name="maximum_allowed" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not employee_id" groups="hr.group_hr_user"/>
                            <field name="already_outstanding" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="not employee_id" groups="hr.group_hr_user"/>
                            <field name="eligible_amount" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-bf="1" invisible="not employee_id" groups="hr.group_hr_user"/>
                            
                            <separator string="Recovery Information" invisible="state not in ('paid', 'closed')"/>
                            <field name="deducted_amount" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="state not in ('paid', 'closed')"/>
                            <field name="balance_amount" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-bf="1" invisible="state not in ('paid', 'closed')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Accounting" invisible="state == 'draft'" groups="hr.group_hr_user">
                            <group>
                                <group>
                                    <field name="journal_id" readonly="state in ('approved', 'paid', 'closed', 'cancelled')"/>
                                    <field name="receivable_account_id" readonly="state in ('approved', 'paid', 'closed', 'cancelled')"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List view of salary advance -->
    <record model="ir.ui.view" id="salary_advance_view_tree">
        <field name="name">salary.advance.view.list</field>
        <field name="model">salary.advance</field>
        <field name="arch" type="xml">
            <list string="Salary Advance">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date"/>
                <field name="advance"/>
                <field name="balance_amount"/>
                <field name="state" widget="badge" 
                       decoration-info="state == 'submitted'" 
                       decoration-warning="state == 'approved'" 
                       decoration-success="state in ('paid', 'closed')" 
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Search view of salary advance -->
    <record id="salary_advance_view_search" model="ir.ui.view">
        <field name="name">salary.advance.view.search</field>
        <field name="model">salary.advance</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="name" string="Salary Advance" filter_domain="['|',('name','ilike',self)]"/>
                <field name="employee_id"/>
                <field name="state"/>
                <filter string="My Requests" domain="[('employee_id.user_id.id','=',uid)]" name="my_requests_filter"/>
                <filter domain="[('state', '=', 'draft')]" string="To Submit" name="to_report" help="New Requests"/>
                <filter domain="[('state', '=', 'submitted')]" string="To Approve" name="submitted" help="Submitted Requests"/>
                <filter domain="[('state', '=', 'approved')]" string="Approved" name="approved" help="Approved Requests"/>
                <filter domain="[('state', 'in', ('approved', 'paid'))]" string="Outstanding" name="outstanding" help="Outstanding Advances"/>
                <filter domain="[('state', '=', 'closed')]" string="Closed" name="closed" help="Closed Advances"/>
                <separator/>
                <filter string="Employee" name="employee_id" domain="[]" context="{'group_by':'employee_id'}"/>
                <filter name="State" string="State" domain="[]" context="{'group_by':'state'}"/>
                <filter string="Company" domain="[]" name="company" context="{'group_by':'company_id'}"/>
                <filter string="Department" domain="[]" name="department" context="{'group_by':'department_id'}"/>
            </search>
        </field>
    </record>

    <!-- Window actions -->
    <record id="salary_advance_action" model="ir.actions.act_window">
        <field name="name">Salary Advance</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">salary.advance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="salary_advance_view_search"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create a new Salary Advance Request.
            </p>
        </field>
    </record>

    <!-- Menu items -->
    <menuitem id="salary_advance_menu_root"
              name="Salary Advance"
              parent="ohrms_loan.hr_loan_menu_root"
              action="salary_advance_action"
              sequence="7"/>
</odoo>
