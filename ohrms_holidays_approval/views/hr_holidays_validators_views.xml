<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view of the model hr.holidays.validators -->
    <record id='hr_holidays_validators_view_tree' model='ir.ui.view'>
        <field name="name">hr.holidays.validators.view.list</field>
        <field name="model">hr.holidays.validators</field>
        <field name="arch" type="xml">
            <list string="Leave Validators">
                <field name="name"/>
                <field name="user_id"/>
            </list>
        </field>
    </record>

    <!-- Form view of the model hr.holidays.validators -->
    <record id="hr_holidays_validators_view_form" model="ir.ui.view">
        <field name="name">hr.holidays.validators.view.form</field>
        <field name="model">hr.holidays.validators</field>
        <field name="arch" type="xml">
            <form string="Leave Validator">
                <sheet>
                    <group>
                        <field name="user_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
