<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit hr leave form view to show validation status notebook -->
    <record id="hr_leave_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit.ohrms.holidays.approval</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_hr_leave_content')]" position="after">
                <field name="multi_level_validation" invisible="1"/>
                <field name="user_ids" invisible="1"/>
                <notebook invisible="not multi_level_validation">
                    <page string="Validation Status">
                        <field name="validation_status_ids" mode="list"
                               readonly="state in ['refuse','validate']">
                            <list string="Users" create="false" delete="false">
                                <field name="user_id"/>
                                <field name="validation_status"/>
                                <field name="leave_comments"
                                       readonly="user_id != uid"/>
                            </list>
                            <form>
                                <group>
                                    <field name="user_id"/>
                                    <field name="leave_comments"/>
                                </group>
                            </form>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <!-- Approval requests menu action-->
    <record id="hr_leave_action_approvals" model="ir.actions.server">
        <field name="name">Approval Requests</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave"/>
        <field name="state">code</field>
        <field name="code">
action = model._get_approval_requests()
        </field>
    </record>

    <!-- Approval requests menu-->
    <menuitem
            id="hr_leave_menu"
            name="Approval Requests"
            parent="hr_holidays.menu_hr_holidays_root"
            action="hr_leave_action_approvals"
            sequence="3"/>
</odoo>
