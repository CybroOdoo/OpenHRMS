<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
        <!-- Search view of payslip runs -->
    <record id="hr_payslip_run_search" model="ir.ui.view">
        <field name="name">hr.payslip.run.search</field>
        <field name="model">hr.payslip.run</field>
        <field name="arch" type="xml">
            <search string="Search Payslip Batches">
                <field name="name" string="Payslip Batches"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <filter string="Draft" name="draft"
                        domain="[('state','=','draft')]"
                        help="Draft Payslip Batches"/>
                <filter name="done_filter" string="Done"
                        domain="[('state','=','done')]"
                        help="Done Payslip Batches"/>
            </search>
        </field>
    </record>

    <!-- Specific tree view for payslips inside a batch to hide 'Add a line' -->
    <record id="hr_payslip_run_slip_tree" model="ir.ui.view">
        <field name="name">hr.payslip.run.slip.tree</field>
        <field name="model">hr.payslip</field>
        <field name="priority">999</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="number" string="Reference"/>
                <field name="employee_id"/>
                <field name="name" string="Payslip Name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="employer_cost"/>
                <field name="basic_wage"/>
                <field name="gross_wage"/>
                <field name="net_wage"/>
                <field name="state" string="Status" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-primary="state == 'paid'" decoration-muted="state == 'cancel'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

<!--    List view of hr_payslip_run-->
    <record id="hr_payslip_run_view_tree" model="ir.ui.view">
        <field name="name">hr.payslip.run.view.list</field>
        <field name="model">hr.payslip.run</field>
        <field name="arch" type="xml">
            <list string="Payslips Batches">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="credit_note"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    <!--    Kanban view of hr_payslip_run-->
    <record id="hr_payslip_run_view_kanban" model="ir.ui.view">
        <field name="name">hr.payslip.run.view.kanban</field>
        <field name="model">hr.payslip.run</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_content oe_kanban_global_click">
                            <div class="row">
                                <div class="col-6">
                                    <strong>
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="col-6">
                                    <span class="float-right badge badge-secondary">
                                        <field name="state"/>
                                    </span>
                                </div>
                                <div class="col-12">
                                    <span>
                                        <field name="date_start"/>
                                        -
                                        <field name="date_end"/>
                                    </span>
                                    <span class="float-right"
                                          title="Is a Blocking Reason?">
                                        <field name="credit_note"
                                               widget="boolean"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
<!--   Form view of hr_payslip_run-->
    <record id="hr_payslip_run_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.run.view.form</field>
        <field name="model">hr.payslip.run</field>
        <field name="arch" type="xml">
            <form string="Payslips Batches">
                <header>

                    <button name="%(action_hr_payslip_run_generate)d"
                            type="action" invisible="state != 'draft'"
                            string="Run" class="oe_highlight"/>
                    <button name="action_confirm_payslips" type="object"
                            string="Validate Payslips" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_mark_as_paid" type="object"
                            string="Mark as Paid" class="oe_highlight"
                            invisible="state != 'done'"/>
                    <button name="action_cancel_payslips" type="object"
                            string="Cancel Payslips"
                            invisible="state in ('draft', 'cancel')"/>
                    <button string="Set to Draft" name="action_payslip_run"
                            type="object" invisible="state not in ('cancel', 'done', 'paid')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done,paid"/>
                </header>
                <sheet>
                    <label for="name" class="oe_edit_only"/>
                    <h1>
                        <field name="name" readonly="state != 'draft'"/>
                    </h1>
                    <group col="4">
                        <label for="date_start" string="Period"
                               readonly="state != 'draft'"/>
                        <div>
                            <field name="date_start" class="oe_inline"/>
                            -
                            <field name="date_end" class="oe_inline"
                                   readonly="state != 'draft'"/>
                        </div>
                        <field name="credit_note" readonly="state != 'draft'"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <separator string="Payslips"/>
                    <field name="slip_ids" readonly="state != 'draft'">
                        <list create="0">
                            <field name="number" string="Reference"/>
                            <field name="employee_id"/>
                            <field name="name" string="Payslip Name"/>
                            <field name="date_from"/>
                            <field name="date_to"/>
                            <field name="employer_cost"/>
                            <field name="basic_wage"/>
                            <field name="gross_wage"/>
                            <field name="net_wage"/>
                            <field name="state" string="Status" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'done'" decoration-primary="state == 'paid'" decoration-muted="state == 'cancel'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
<!--    Window action for hr_payslip_run-->
    <record id="hr_payslip_run_action" model="ir.actions.act_window">
        <field name="name">Payslips Batches</field>
        <field name="res_model">hr.payslip.run</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="hr_payslip_run_search"/>
    </record>
<!--    Menu for hr_payslip-->
    <menuitem action="hr_payslip_run_action" id="menu_hr_payslip_run"
              parent="menu_hr_payroll_community_root"/>
</odoo>
