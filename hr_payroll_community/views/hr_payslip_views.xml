<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- payslip -->
    <record id="hr_payslip_view_tree" model="ir.ui.view">
        <field name="name">hr.payslip.view.list</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <list decoration-muted="state == 'cancel'" string="Payslips">
                <field name="number"/>
                <field name="employee_id"/>
                <field name="name"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="employer_cost" sum="Total"/>
                <field name="basic_wage" sum="Total"/>
                <field name="gross_wage" sum="Total"/>
                <field name="net_wage" sum="Total"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"
                       options="{'no_create': True}"/>
                <field name="payslip_run_id" column_invisible="True"/>
            </list>
        </field>
    </record>

    <!-- Payslip kanban view -->
    <record id="hr_payslip_view_kanban" model="ir.ui.view">
        <field name="name">hr.payslip.view.kanban</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_content oe_kanban_global_click">
                            <div class="row">
                                <div class="col-6">
                                    <strong>
                                        <field name="employee_id"/>
                                    </strong>
                                </div>
                                <div class="col-6">
                                    <span class="float-end badge text-bg-secondary">
                                        <field name="state"/>
                                    </span>
                                </div>
                                <div class="col-12">
                                    <span>
                                        <field name="date_from"/>
                                        -
                                        <field name="date_to"/>
                                    </span>
                                </div>
                                <div class="col-12">
                                    <span>
                                        <field name="name"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Payslip form view -->
    <record id="hr_payslip_view_form" model="ir.ui.view">
        <field name="name">hr.payslip.view.form</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <form string="Payslip">
                <header>
                    <button string="Validate" name="action_payslip_done"
                            type="object" invisible="state != 'draft' or not line_ids"
                            class="oe_highlight"/>

                    <button string="Send Mail"
                            name="action_payslip_send"
                            type="object"
                            class="oe_highlight" invisible="state not in ('done', 'paid') or is_send_mail == True"/>
                    <button string="Set to Draft" name="action_payslip_draft"
                            type="object" invisible="state != 'cancel'"/>
                    <button string="Compute Sheet" name="action_compute_sheet"
                            type="object" invisible="state != 'draft'"
                            class="oe_highlight"/>
                    <button string="Cancel Payslip" name="action_payslip_cancel"
                            type="object"
                            invisible="state in ('draft', 'cancel')"/>
                    <button string="Mark as Paid" name="action_mark_as_paid" type="object"
                            class="oe_highlight" invisible="state != 'done'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,done,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_hr_payslip_line)d"
                                class="oe_stat_button"
                                icon="attach_money"
                                type="action"
                                invisible="1">
                            <field name="payslip_count" widget="statinfo"
                                   string="Payslip"
                                   help="Payslip Computation Details"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <field name="is_send_mail" invisible="1"/>
                        <label for="employee_id" class="oe_edit_only"/>
                        <h1>
                            <field name="employee_id" placeholder="Employee"
                                   readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group col="4">
                        <label for="date_from" string="Period"/>
                        <div>
                            <field name="date_from" class="oe_inline"
                                   readonly="state != 'draft'"/>
                            -
                            <field name="date_to" class="oe_inline"
                                   readonly="state != 'draft'"/>
                        </div>
                        <field name="contract_id"
                               domain="[('employee_id','=',employee_id),('date_start','&lt;=',date_to),'|',('date_end','&gt;=',date_from),('date_end','=',False)]"
                               context="{'default_employee_id': employee_id}"
                               readonly="state != 'draft'"/>
                        <field name="number" readonly="state != 'draft'"/>
                        <field name="struct_id" readonly="state != 'draft'"/>
                        <field name="name" readonly="state != 'draft'"/>
                        <field name="credit_note" readonly="state != 'draft'"/>
                    </group>
                    <notebook>
                        <page string="Worked Days &amp; Inputs">
                            <separator string="Worked Days"/>
                            <field name="worked_days_line_ids"
                                   readonly="state != 'draft'">
                                <list string="Worked Days" editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="number_of_days"
                                           sum="Total Working Days"/>
                                    <field name="number_of_hours"/>
                                    <field name="amount" sum="Total Amount"/>
                                    <field name="currency_id" column_invisible="True"/>
                                    <field name="contract_id"
                                           domain="[('employee_id','=',parent.employee_id)]"
                                           context="{'default_employee_id': parent.employee_id}"/>
                                    <field name="sequence" column_invisible="True"/>
                                </list>
                                <form string="Worked Day">
                                    <group col="4">
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="sequence"/>
                                        <field name="number_of_days"/>
                                        <field name="number_of_hours"/>
                                        <field name="amount"/>
                                        <field name="currency_id" invisible="1"/>
                                        <field name="contract_id"
                                               domain="[('employee_id','=',parent.employee_id)]"
                                               context="{'default_employee_id': parent.employee_id}"/>
                                    </group>
                                </form>
                            </field>
                            <separator string="Other Inputs"/>
                            <field name="input_line_ids" colspan="4" nolabel="1"
                                   readonly="state != 'draft'">
                                <list string="Input Data" editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="amount"/>
                                    <field name="contract_id"
                                           domain="[('employee_id','=',parent.employee_id)]"
                                           context="{'default_employee_id': parent.employee_id}"/>
                                    <field name="sequence" column_invisible="True"/>
                                </list>
                                <form string="Payslip Line">
                                    <group col="4">
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="sequence"/>
                                        <field name="amount"/>
                                        <field name="contract_id"
                                               domain="[('employee_id','=',parent.employee_id)]"
                                               context="{'default_employee_id': parent.employee_id}"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Salary Computation">
                            <field name="line_ids" colspan="4" nolabel="1"
                                   readonly="state != 'draft'">
                                <list string="Salary Structure"
                                      editable="bottom"
                                      decoration-info="total == 0">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="category_id"/>
                                    <field name="sequence" column_invisible="True"/>
                                    <field name="quantity"/>
                                    <field name="rate"/>
                                    <field name="salary_rule_id"/>
                                    <field name="amount"/>
                                    <field name="total"/>
                                </list>
                                <form string="Payslip Line">
                                    <group col="4">
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="category_id"/>
                                        <field name="sequence"/>
                                        <field name="quantity"/>
                                        <field name="rate"/>
                                        <field name="amount"/>
                                        <field name="total"/>
                                        <field name="salary_rule_id"/>
                                    </group>
                                </form>
                            </field>
                        </page>
                        <page string="Details By Salary Rule Category">
                            <field name="details_by_salary_rule_category_ids"
                                   context="{'search_default_category_id':1}"
                                   domain="[('appears_on_payslip', '=', True)]">
                                <list string="Payslip Lines"
                                      decoration-info="total == 0">
                                    <field name="category_id"/>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Accounting Information">
                            <group>
                                <group string="Miscellaneous">
                                    <field name="company_id"
                                           groups="base.group_multi_company"
                                           readonly="state != 'draft'"/>
                                    <field name="payslip_run_id"
                                           domain="[('state','=','draft')]"
                                           readonly="state != 'draft'"/>
                                </group>
                                <group name="accounting" string="Accounting">
                                    <field name="paid"
                                           readonly="state != 'draft'"/>
                                </group>
                            </group>
                            <div colspan="4">
                                <field name="note"
                                       placeholder="Add an internal note..."
                                       readonly="state != 'draft'"/>
                            </div>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search view for Payslips -->
    <record id="hr_payslip_search" model="ir.ui.view">
        <field name="name">hr.payslip.search</field>
        <field name="model">hr.payslip</field>
        <field name="arch" type="xml">
            <search string="Search Payslips">
                <field name="name" string="Payslips"
                       filter_domain="['|',('name','ilike',self),('number','ilike',self)]"/>
                <field name="date_from"/>
                <filter string="Draft" name="draft"
                        domain="[('state','=','draft')]" help="Draft Slip"/>
                <filter string="Done" name="done"
                        domain="[('state','=','done')]" help="Done Slip"/>
                <field name="employee_id"/>
                <field name="payslip_run_id"/>
                <group>
                    <filter string="Employees" name="employee_id" context="{'group_by':'employee_id'}"/>
                    <filter string="PaySlip Batch" name="payslip_run_id" context="{'group_by':'payslip_run_id'}"/>
                    <filter string="Companies" name="company_id" groups="base.group_multi_company" context="{'group_by':'company_id'}"/>
                    <filter string="States" name="state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="hr_payslip_action" model="ir.actions.act_window">
        <field name="name">Employee Payslips</field>
        <field name="res_model">hr.payslip</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="search_view_id" ref="hr_payslip_search"/>
    </record>

    <menuitem action="hr_payslip_action"
              id="menu_department_tree"
              parent="menu_hr_payroll_community_root"
              groups="hr_payroll_community.group_hr_payroll_community_user"/>

    <record id="action_hr_payslip" model="ir.actions.act_window">
        <field name="res_model">hr.payslip</field>
        <field name="name">Payslips</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="context">{'search_default_employee_id': [active_id],
            'default_employee_id': active_id}
        </field>
    </record>
</odoo>
