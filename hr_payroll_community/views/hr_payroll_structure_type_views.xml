<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_payroll_structure_type_form_inherit_payroll" model="ir.ui.view">
        <field name="name">hr.payroll.structure.type.form.inherit.payroll</field>
        <field name="model">hr.payroll.structure.type</field>
        <!-- Inherit if there's a base form, else we define one or just use standard fields. -->
        <field name="arch" type="xml">
            <form string="Salary Structure Type">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="country_id"/>
                        </group>
                        <group>
                            <field name="default_resource_calendar_id"/>
                            <field name="default_struct_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_payroll_structure_type_tree_inherit_payroll" model="ir.ui.view">
        <field name="name">hr.payroll.structure.type.tree</field>
        <field name="model">hr.payroll.structure.type</field>
        <field name="arch" type="xml">
            <list string="Salary Structure Types">
                <field name="name"/>
                <field name="default_resource_calendar_id"/>
                <field name="country_id"/>
                <field name="default_struct_id"/>
            </list>
        </field>
    </record>

    <record id="action_hr_payroll_structure_type" model="ir.actions.act_window">
        <field name="name">Salary Structure Types</field>
        <field name="res_model">hr.payroll.structure.type</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Salary Structure Type
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_payroll_structure_type"
              name="Structure Types"
              parent="hr_payroll_community.menu_hr_payroll_community_configuration"
              action="action_hr_payroll_structure_type"
              sequence="12"/>
</odoo>
